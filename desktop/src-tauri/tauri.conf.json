{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESP Gauge",
  "version": "2.3.0",
  "identifier": "nz.jmw.esp-gauge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ESP Gauge",
        "width": 1160,
        "height": 720,
        "minWidth": 880,
        "minHeight": 580,
        "backgroundColor": "#202323",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Six outputs. Any instrument.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.6",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libasound2",
          "libpulse0"
        ]
      },
      "rpm": {
        "depends": ["alsa-lib", "pulseaudio-libs"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NDQ0NkVCMUFBREM5NjIKUldSaXlhMGE2MFpFRmFhWUFkQ2ZwODlMVmpGV0FNa2QxZUNMc2lpZXlnRlVJeU5mSlp3RjhmeWgK",
      "endpoints": [
        "https://github.com/Fallstop/esp-gauge/releases/latest/download/latest.json"
      ]
    }
  }
}
